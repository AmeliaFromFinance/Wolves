<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The native file dialog is implemented with classic COM interop (ComImport); the
         analyzer suggestion to migrate to source-generated COM is intentionally silenced. -->
    <NoWarn>$(NoWarn);SYSLIB1096</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="FixedMathSharp" Version="7.1.0" />
    <PackageReference Include="Fmod5Sharp" Version="3.1.0" />
    <PackageReference Include="GenericReader" Version="2.3.0" />
    <PackageReference Include="Infrablack.UE4Config" Version="0.7.2.97" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OffiUtils" Version="3.2.0" />
    <PackageReference Include="Oodle.NET" Version="2.2.0" />
    <PackageReference Include="OodleSharp" Version="0.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="SubstreamSharp" Version="1.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
    <PackageReference Include="VGAudio" Version="2.2.1" />
    <PackageReference Include="Zlib-ng.NET" Version="1.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Defaults\*.json (default customization items + decrypted catalog) are read from next to the exe at runtime -->
    <None Include="Defaults\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CUE4Parse">
      <HintPath>libs\CUE4Parse.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
